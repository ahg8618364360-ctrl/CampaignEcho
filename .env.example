# ==============================================================================
# CampaignEcho Environment Configuration Example
# Copy this file to .env and populate with your credentials.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# Application Environment
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./campaignecho.db
FRONTEND_URL=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Vectorize Hindsight Configuration
# Official Documentation: https://hindsight.vectorize.io/
# Cloud Endpoint (Default): https://api.hindsight.vectorize.io
# Self-hosted Local Server: http://localhost:8888
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_TIMEOUT=30
HINDSIGHT_MAX_RETRIES=3

# Primary LLM Provider: Z.ai (GLM-4.5-Flash)
LLM_PROVIDER=zai
LLM_MODEL=glm-4.5-flash
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Alternative LLM Provider: Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096
